# Frontend Vite Environment Variables (used by browser)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public Contact Information
VITE_SUPPORT_EMAIL=support@yourdomain.com
VITE_SUPPORT_PHONE=1-800-UPSTARS
VITE_WEBSITE_URL=www.yourdomain.com

# Environment
VITE_NODE_ENV=production

# ============================================================
# Supabase Edge Function Secrets (set in Supabase Dashboard)
# Do NOT prefix with VITE_ - these stay on the server
# ============================================================

# Service role key (keep secret, never expose to browser)
SB_SERVICE_ROLE_KEY=your_service_role_key

# Allowed origin for domain lock (your live domain)
ALLOWED_ORIGIN=https://yourdomain.vercel.app

# Admin credentials
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password

# Customer default dashboard password
DEFAULT_CUSTOMER_PASSWORD=UpStarLoan#2024

# Google Apps Script URLs (all hidden on server)
CUSTOMER_SERVICE_SCRIPT_URL=your_customer_service_script_url
LOAN_APP_SCRIPT_URL=your_loan_app_script_url
PERSONAL_FINANCING_SCRIPT_URL=your_personal_financing_script_url
LOAN_APPLICATION_SCRIPT_URL=your_loan_application_script_url
CONTACT_SCRIPT_URL=your_contact_script_url