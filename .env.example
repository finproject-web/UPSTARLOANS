# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Credentials (Set these in your hosting platform environment variables)
VITE_ADMIN_EMAIL=your_admin_email
VITE_ADMIN_PASSWORD=your_admin_password

# Public Contact Information
VITE_SUPPORT_EMAIL=support@yourdomain.com
VITE_SUPPORT_PHONE=1-800-UPSTARS
VITE_WEBSITE_URL=www.yourdomain.com

# Google Apps Script URLs (For form submissions without backend)
VITE_GSHEET_LOAN_APP_URL=your_google_script_url_1
VITE_GSHEET_PERSONAL_FINANCING_URL=your_google_script_url_2
VITE_GSHEET_LOAN_APPLICATION_URL=your_google_script_url_3
VITE_GSHEET_CONTACT_URL=your_google_script_url_4
VITE_GSHEET_CUSTOMER_SERVICE_URL=your_google_script_url_5

# Environment
VITE_NODE_ENV=production